@using MicroShop.Web.Domain.DTOs.CartDTOs
@model IEnumerable<CartProductDetailsDTO>

@{
    ViewData["Title"] = "Cart Items";
}

<h1>Cart Items</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<form asp-action="DeleteAllUserCartItemsByUserId" asp-controller="Carts" method="post">
    <button type="submit" class="btn btn-danger">Remove all products</button>
</form>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Product Name</th>
                <th>Product Price</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.ProductName</td>
                    <td>@item.ProductPrice</td>
                    <td>
                        <form asp-action="UpdateQuantityProductInCartItem" asp-controller="Carts" method="post" class="form-inline" style="display: inline-block;">
                            <input type="hidden" name="UserId" value="@item.UserId" />
                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                            <input type="hidden" name="Quantity" value="1" />
                            <input type="hidden" name="AddOrRemove" value="false" />
                            <button type="submit" class="btn btn-primary">-</button>
                        </form>
                        <label style="display: inline-block; width: 50px; text-align: center;">@item.ProductQuantity</label>
                        <form asp-action="UpdateQuantityProductInCartItem" asp-controller="Carts" method="post" class="form-inline" style="display: inline-block;">
                            <input type="hidden" name="UserId" value="@item.UserId" />
                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                            <input type="hidden" name="Quantity" value="1" />
                            <input type="hidden" name="AddOrRemove" value="true" />
                            <button type="submit" class="btn btn-primary">+</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="DeleteOneCartItemInUser" asp-controller="Carts" method="post">
                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-primary">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No cart items found.</p>
}
